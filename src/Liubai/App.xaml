<Application
    x:Class="Liubai.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#167E6B" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6167E6B" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC167E6B" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#106D5C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#73D4BA" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E673D4BA" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC73D4BA" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#8CE0C9" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
