<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="LiubaiCardBrush" Color="#17808080" />
            <SolidColorBrush x:Key="LiubaiCardBorderBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="LiubaiActionBorderBrush" Color="#BEFFFFFF" />
            <SolidColorBrush x:Key="LiubaiActionBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14000000" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#20000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#28000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#38000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="LiubaiCardBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="LiubaiCardBorderBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="LiubaiActionBorderBrush" Color="#58FFFFFF" />
            <SolidColorBrush x:Key="LiubaiActionBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#30FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#48FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="LiubaiCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LiubaiCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="LiubaiActionBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="LiubaiActionBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Liubai visual language 1.0. All measurements are effective pixels. -->
    <Thickness x:Key="LiubaiPanelPadding">20,16,20,16</Thickness>
    <Thickness x:Key="LiubaiCardPadding">12</Thickness>
    <CornerRadius x:Key="LiubaiPanelRadius">16</CornerRadius>
    <CornerRadius x:Key="LiubaiCardRadius">12</CornerRadius>
    <CornerRadius x:Key="LiubaiControlRadius">8</CornerRadius>
    <x:Double x:Key="LiubaiPanelGap">12</x:Double>
    <x:Double x:Key="LiubaiActionGap">4</x:Double>
    <x:Double x:Key="LiubaiTitleSize">23</x:Double>
    <x:Double x:Key="LiubaiHintSize">12</x:Double>
    <x:Double x:Key="LiubaiIconSize">20</x:Double>
    <x:Double x:Key="LiubaiActionSize">36</x:Double>
    <x:Double x:Key="LiubaiIconStroke">1.5</x:Double>
    <x:Double x:Key="LiubaiEnterMilliseconds">160</x:Double>
    <x:Double x:Key="LiubaiEnterOffset">4</x:Double>
    <!-- Panel glass is independent of the user's maximized/top-bar appearance. -->
    <x:Double x:Key="LiubaiPanelTintOpacity">0.22</x:Double>
    <x:Double x:Key="LiubaiPanelLuminosityOpacity">0.78</x:Double>



    <!-- Retain the WinUI templates, including focus, disabled and contrast states. -->
    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource LiubaiControlRadius}" />
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="CornerRadius" Value="{StaticResource LiubaiControlRadius}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource LiubaiControlRadius}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource LiubaiControlRadius}" />
    </Style>
    <Style TargetType="NumberBox">
        <Setter Property="CornerRadius" Value="{StaticResource LiubaiControlRadius}" />
    </Style>
    <Style TargetType="Expander">
        <Setter Property="CornerRadius" Value="{StaticResource LiubaiCardRadius}" />
    </Style>
    <Style x:Key="LiubaiIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource LiubaiActionSize}" />
        <Setter Property="Height" Value="{StaticResource LiubaiActionSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource LiubaiControlRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="LiubaiIconToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource LiubaiActionSize}" />
        <Setter Property="Height" Value="{StaticResource LiubaiActionSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource LiubaiControlRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="LiubaiCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource LiubaiCardRadius}" />
        <Setter Property="Padding" Value="{StaticResource LiubaiCardPadding}" />
        <Setter Property="Background" Value="{ThemeResource LiubaiCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LiubaiCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="LiubaiItemActionStyle" TargetType="Button" BasedOn="{StaticResource LiubaiIconButtonStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource LiubaiActionBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource LiubaiActionBrush}" />
    </Style>
</ResourceDictionary>
