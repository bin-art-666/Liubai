<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <Color x:Key="SystemAccentColor">#0F705B</Color>
   <Color x:Key="SystemAccentColorDark1">#0F705B</Color>
   <Color x:Key="SystemAccentColorLight1">#25816B</Color>
   <SolidColorBrush x:Key="LiubaiCanvasBrush" Color="#F5F7F7" />
   <SolidColorBrush x:Key="LiubaiSurfaceBrush" Color="#FFFFFF" />
   <SolidColorBrush x:Key="LiubaiBorderBrush" Color="#DAE3DE" />
   <SolidColorBrush x:Key="LiubaiTextBrush" Color="#1E2B29" />
   <SolidColorBrush x:Key="LiubaiMutedBrush" Color="#64746F" />
   <SolidColorBrush x:Key="LiubaiAccentBrush" Color="#0F705B" />
   <SolidColorBrush x:Key="LiubaiAccentSoftBrush" Color="#E2F4EC" />
   <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1E2B29" />
   <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#64746F" />
   <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0F705B" />
   <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#25816B" />
   <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3E907B" />
   <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
  </ResourceDictionary>
  <ResourceDictionary x:Key="Dark">
   <Color x:Key="SystemAccentColor">#8BE0C2</Color>
   <Color x:Key="SystemAccentColorDark1">#73C9AC</Color>
   <Color x:Key="SystemAccentColorLight1">#8BE0C2</Color>
   <SolidColorBrush x:Key="LiubaiCanvasBrush" Color="#1C1F23" />
   <SolidColorBrush x:Key="LiubaiSurfaceBrush" Color="#25292D" />
   <SolidColorBrush x:Key="LiubaiBorderBrush" Color="#424C48" />
   <SolidColorBrush x:Key="LiubaiTextBrush" Color="#EFF3F2" />
   <SolidColorBrush x:Key="LiubaiMutedBrush" Color="#A9B6B2" />
   <SolidColorBrush x:Key="LiubaiAccentBrush" Color="#8BE0C2" />
   <SolidColorBrush x:Key="LiubaiAccentSoftBrush" Color="#2A483F" />
   <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EFF3F2" />
   <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A9B6B2" />
   <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8BE0C2" />
   <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#79CBB0" />
   <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#69B69C" />
   <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#142D24" />
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
 <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
  <Setter Property="CornerRadius" Value="8" />
  <Setter Property="MinHeight" Value="36" />
  <Setter Property="Padding" Value="14,8" />
  <Setter Property="FontSize" Value="14" />
 </Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
  <Setter Property="CornerRadius" Value="8" />
  <Setter Property="MinHeight" Value="40" />
  <Setter Property="Padding" Value="12,8" />
  <Setter Property="FontSize" Value="14" />
 </Style>
 <Style x:Key="LiubaiPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
  <Setter Property="CornerRadius" Value="8" />
  <Setter Property="MinHeight" Value="38" />
  <Setter Property="Padding" Value="20,8" />
 </Style>
</ResourceDictionary>
